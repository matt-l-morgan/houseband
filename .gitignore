# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Soundfonts are fetched, never committed. They are 40-150MB, and while both
# default banks are MIT, a user may well drop a bank in here whose license does
# not permit redistribution. See docs/soundfonts.md.
soundfonts/
*.sf2
*.sf3

# Run output: event logs, candidate programs, MIDI, audio, piano rolls. Large,
# and every run produces a new one.
runs/

# Per-user configuration. Holds a soundfont path and model choices, and is the
# one file a user might be tempted to put a credential in. Never committed.
config.toml

# Reference MIDI. The feature that used one is gone, but the directory is still
# ignored outright: anyone who kept a community transcription of a copyrighted
# song here must not have it swept into a commit.
references/

# Playbooks are per-run learning state, not source.
playbooks/

# The coach's learned house-library functions are committed on purpose: the
# whole point is that a capability persists. Nothing to ignore here, noted so
# nobody adds it later by reflex.

# Local scratch
scratch/
tmp/
*.log

# macOS
.DS_Store
